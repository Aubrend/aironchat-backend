# ==============================================
# AIRONCHAT BACKEND - Variáveis de Ambiente
# ==============================================
# Copie este arquivo para .env e preencha os valores reais

PORT=3000

# PostgreSQL (Neon) - inclua ?sslmode=require
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/aironchat?sslmode=require

# JWT
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui

# Groq API
GROQ_API_KEY=sua_chave_groq_aqui

# Ambiente
NODE_ENV=production